{$SITE_ADDRESS} {
	encode gzip

	# No Cache-Control override for /uploads: image URLs are derived from row ids
	# (drink_arab.jpg) and get overwritten when a photo is replaced, so the
	# max-age=0 express.static already sends is what we want — the browser
	# revalidates and a 304 costs ~200 bytes.
	reverse_proxy app:3001
}
